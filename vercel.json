{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/linkedin", "destination": "https://www.linkedin.com/in/dotenorio", "permanent": false },
    { "source": "/github", "destination": "https://github.com/dotenorio", "permanent": false },
    { "source": "/telegram", "destination": "https://telegram.me/dotenorio", "permanent": false },
    { "source": "/twitter", "destination": "https://twitter.com/dotenorio", "permanent": false },
    { "source": "/facebook", "destination": "https://www.facebook.com/dotenorio", "permanent": false },
    { "source": "/steam", "destination": "https://steamcommunity.com/id/dotenorio", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
